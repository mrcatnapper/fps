  "codec": {
    "max_frame_payload": 1280,
    "max_frame_padding": 64,
    "allow_fragmentation": true
  },
  "logging": {
    "level": "info"
  },
  "ops": {
    "status_socket": "/run/fps/client.status"
  }
}
