{
  "network": {
    "listen": "0.0.0.0:7443",
    "server": "fps-server:8443",
    "read_buffer_size": 65536
  },
  "security": {
    "zero_rtt": {
      "enabled": true,
      "profile_id": "debug-carrier-v5",
      "client_uuid": "123e4567-e89b-42d3-a456-426614174000",
      "server_public_key_base64": "PASTE_server_public_key_base64_HERE"
